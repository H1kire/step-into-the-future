{
  "rules": {
    "accountCounter": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val() + 1) || (!data.exists() && newData.val() === 1))"
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || newData.child('nickname').val() === data.child('nickname').val() || now - data.child('nicknameChangedAt').val() >= 86400000)",
        ".validate": "newData.hasChildren(['accountNumber', 'nickname', 'createdAt', 'nicknameChangedAt'])",
        "accountNumber": {
          ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "nicknameChangedAt": {
          ".validate": "newData.isNumber() && (newData.val() === data.val() || (newData.parent().child('nickname').val() !== data.parent().child('nickname').val() && newData.val() <= now && (!data.exists() || now - data.val() >= 86400000)))"
        },
        "$other": {
          ".validate": false
        }
      },
      ".read": "auth != null"
    },
    "chatMessages": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$messageId": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && now - data.child('createdAt').val() >= 600000))",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 'lat', 'lng', 'createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 180"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'lat', 'lng', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "gameSaves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['data', 'updatedAt'])",
        "data": {
          ".validate": "newData.hasChildren(['state', 'monsters'])",
          "state": {
            ".validate": "newData.hasChildren(['level', 'hp', 'maxHp', 'energy', 'maxEnergy'])",
            "level": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
            },
            "hp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "maxHp": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000"
            },
            "energy": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "maxEnergy": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000"
            }
          },
          "monsters": {
            ".validate": "newData.hasChildren() || !newData.exists()"
          },
          "$other": {
            ".validate": true
          }
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "nicknameIndex": {
      ".read": "auth != null",
      "$nickname": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "friends": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null && ((!data.exists() && newData.child('leaderUid').val() === auth.uid) || data.child('leaderUid').val() === auth.uid || (data.child('members').child(auth.uid).exists() && !newData.child('members').child(auth.uid).exists()))",
        "members": {
          ".validate": "newData.numChildren() <= 5"
        }
      }
    },
    "groupMembers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "mail": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('fromUid').val() === auth.uid))"
      }
    },
    "directMessages": {
      ".read": false,
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$peer": {
          ".read": "auth != null && (auth.uid === $owner || auth.uid === $peer)",
          ".write": "auth != null && (auth.uid === $owner || auth.uid === $peer)"
        }
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nickname','classId','level','updatedAt'])",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "classId": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
